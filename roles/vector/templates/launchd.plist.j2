<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{{ vector_macos_label }}</string>
  <key>ProgramArguments</key><array>
    <string>{{ vector_config_base }}/bin/vector</string>
    <string>--config</string>
    <string>{{ vector_config_base }}/vector.yaml</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>30</integer>
  <key>StandardOutPath</key><string>{{ vector_config_base }}/agent.log</string>
  <key>StandardErrorPath</key><string>{{ vector_config_base }}/agent.err.log</string>
</dict></plist>
