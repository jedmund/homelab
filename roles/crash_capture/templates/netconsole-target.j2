#!/bin/sh
# {{ ansible_managed }}
# Configure a dynamic netconsole target through configfs. Kernel messages at
# or above the console log level are sent to
# {{ crash_capture_netconsole_receiver }} as UDP.
set -eu

target=/sys/kernel/config/netconsole/{{ crash_capture_netconsole_target }}

case "${1:-}" in
  start)
    modprobe netconsole
    mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
    [ -d "$target" ] || mkdir "$target"
    if [ "$(cat "$target/enabled")" = 1 ]; then
      echo 0 > "$target/enabled"
    fi
    echo {{ ansible_facts.default_ipv4.interface }} > "$target/dev_name"
    echo {{ ansible_host }} > "$target/local_ip"
    echo {{ hostvars[crash_capture_netconsole_receiver].ansible_host }} > "$target/remote_ip"
    echo {{ crash_capture_netconsole_port }} > "$target/remote_port"
    echo {{ hostvars[crash_capture_netconsole_receiver].ansible_facts.default_ipv4.macaddress }} > "$target/remote_mac"
    echo 1 > "$target/enabled"
    ;;
  stop)
    if [ -d "$target" ]; then
      echo 0 > "$target/enabled"
      rmdir "$target"
    fi
    ;;
  *)
    echo "usage: $0 start|stop" >&2
    exit 2
    ;;
esac
