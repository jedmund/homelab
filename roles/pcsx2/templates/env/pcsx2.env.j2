# {{ ansible_managed }}
# PCSX2 + RomM streaming broker environment

# LinuxServer base
PUID={{ puid }}
PGID={{ pgid }}
TZ={{ timezone }}

# Selkies basic auth (direct LAN access to the container's own listener)
CUSTOM_USER={{ pcsx2_selkies_user }}
PASSWORD={{ pcsx2_selkies_password }}

# NVIDIA. The runtime exposes compute+utility by default; Selkies needs
# the graphics and video capabilities too. Set here as well as in the
# compose reservation because the two paths are checked independently.
NVIDIA_DRIVER_CAPABILITIES=all
NVIDIA_VISIBLE_DEVICES={{ pcsx2_gpu_device_id }}

# RomM broker mod
DOCKER_MODS={{ pcsx2_broker_mod }}
BROKER_SECRET={{ pcsx2_broker_secret }}
ROM_ROOT={{ pcsx2_rom_root }}
SAVE_SLOT={{ pcsx2_save_slot }}
BROKER_LOG_LEVEL={{ pcsx2_broker_log_level }}
