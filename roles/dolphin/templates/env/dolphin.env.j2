# {{ ansible_managed }}
# Dolphin + RomM streaming broker environment

# LinuxServer base
PUID={{ puid }}
PGID={{ pgid }}
TZ={{ timezone }}

{% if dolphin_selkies_auth_enabled %}
# Selkies basic auth. Both lines are omitted when disabled: the image
# enables auth_basic on PASSWORD being defined at all, so an empty value
# would gate the UI behind an empty password instead of turning it off.
CUSTOM_USER={{ dolphin_selkies_user }}
PASSWORD={{ dolphin_selkies_password }}
{% endif %}

# NVIDIA. The runtime exposes compute+utility by default; Selkies needs
# the graphics and video capabilities too. Set here as well as in the
# compose reservation because the two paths are checked independently.
NVIDIA_DRIVER_CAPABILITIES=all
NVIDIA_VISIBLE_DEVICES={{ dolphin_gpu_device_id }}

# RomM broker mod
DOCKER_MODS={{ dolphin_broker_mod }}
BROKER_SECRET={{ dolphin_broker_secret }}
ROM_ROOT={{ dolphin_rom_root }}
SAVE_SLOT={{ dolphin_save_slot }}
BROKER_LOG_LEVEL={{ dolphin_broker_log_level }}
