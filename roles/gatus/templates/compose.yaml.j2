# {{ ansible_managed }}
name: {{ stack_name }}

services:
  gatus:
    image: {{ gatus_image }}:{{ gatus_image_tag }}
    container_name: gatus
    restart: {{ restart_policy }}
    networks:
      - proxy
    environment:
      # Points at a directory: Gatus deep-merges every *.yaml inside it, so
      # core config and endpoint definitions stay in separate files.
      GATUS_CONFIG_PATH: /config
      GATUS_LOG_LEVEL: {{ gatus_log_level }}
      TZ: {{ timezone }}
    env_file:
      - ./env/gatus.env
{% if gatus_pinned_hosts | length > 0 %}
    # Sent to Traefik rather than wherever the resolver would point. See
    # gatus_pinned_hosts in defaults for why each name is here.
    extra_hosts:
{% for host in gatus_pinned_hosts %}
      - "{{ host }}:{{ gatus_pinned_host_ip }}"
{% endfor %}
{% endif %}
    volumes:
      - ./config:/config:ro
      - ./data:/data
    labels:
      traefik.enable: "true"
      traefik.http.routers.gatus.rule: "Host(`{{ gatus_domain }}`)"
      traefik.http.routers.gatus.entrypoints: "websecure"
      traefik.http.routers.gatus.tls.certresolver: "letsencrypt"
      traefik.http.services.gatus.loadbalancer.server.port: "{{ gatus_container_port }}"
    # No healthcheck: this image is built from scratch and ships only the
    # gatus binary, with no shell, curl, or wget to run a probe with. A
    # declared probe would fail on every run and sit the container
    # permanently unhealthy while it serves fine. Gatus exposes /health over
    # HTTP for anything checking it from outside the container.
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

  # Renders Gatus's custom-provider payloads into human Discord embeds and
  # forwards them to the operations webhook. Joins the proxy network only so
  # Gatus can reach it; nothing is published. The script is versioned in the
  # repository and mounted read-only, so a script change must recreate the
  # container, which the deployment task handles through its register.
  relay:
    image: {{ gatus_relay_image }}
    restart: {{ restart_policy }}
    networks:
      - proxy
    command: ["python", "/app/relay.py"]
    env_file:
      - ./env/gatus.env
    environment:
      GATUS_HOST_REPORT_GROUP: {{ gatus_host_report_group }}
      GATUS_DASHBOARD_URL: {{ gatus_app_url }}
      GATUS_RUNBOOK_URL: {{ gatus_runbook_url }}
      GATUS_HOST_RUNBOOK_URL: {{ gatus_host_runbook_url }}
    volumes:
      - ./relay/relay.py:/app/relay.py:ro
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

networks:
  proxy:
    name: {{ proxy_network }}
    external: true
