# {{ ansible_managed }}
# Secrets for Gatus. The config files under ./config reference these by
# name as ${VAR} and Gatus substitutes them at load, which keeps every
# credential out of the world-readable config.

GATUS_OIDC_CLIENT_ID={{ gatus_oidc_client_id }}
GATUS_OIDC_CLIENT_SECRET={{ gatus_oidc_client_secret }}

GATUS_SMTP_PASSWORD={{ gatus_smtp_password }}
GATUS_ALERT_TO={{ gatus_alert_to }}

# read_api scope only; used to read runner state from the GitLab API.
GATUS_GITLAB_TOKEN={{ gatus_gitlab_token }}
