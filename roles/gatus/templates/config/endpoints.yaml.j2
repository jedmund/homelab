# {{ ansible_managed }}
# Endpoint definitions. Adding a check is a defaults edit plus a redeploy.
# Every endpoint alerts through whichever providers are configured, so
# enabling Discord in the vault fans every existing check out to it too.
{% set alert_types = [] %}
{% if gatus_alert_to | length > 0 %}{% set _ = alert_types.append('email') %}{% endif %}
{% if gatus_discord_webhook_url | length > 0 %}{% set _ = alert_types.append('custom') %}{% endif %}

endpoints:
  - name: Retained log collection
    group: Infrastructure
    url: http://logging-checks:8080/health
    interval: 2m
    conditions:
      - "[STATUS] == 200"
{% if alert_types %}
    alerts:
{% for alert_type in alert_types %}
      - type: {{ alert_type }}
        description: "Log collection, NAS storage, or metadata snapshots need attention. See roles/logging/README.md."
        send-on-resolved: {{ gatus_alert_send_on_resolved | string | lower }}
{% endfor %}
{% endif %}
{% for runner in gatus_gitlab_runners %}
  # GitLab runner {{ runner.id }} ({{ runner.name }}). Checks that the runner
  # is still talking to GitLab, which plain uptime monitoring cannot see: a
  # dead runner leaves every endpoint around it green.
  - name: "Runner {{ runner.id }} ({{ runner.name }})"
    group: gitlab-runners
    url: "{{ gatus_gitlab_api }}/runners/{{ runner.id }}"
    interval: {{ gatus_gitlab_runner_interval }}
    headers:
      PRIVATE-TOKEN: "${GATUS_GITLAB_TOKEN}"
    conditions:
      - "[STATUS] == 200"
      - "[BODY].online == true"
    ui:
      # The runner payload carries fields we would rather not render on a
      # dashboard; only the conditions above are ever displayed.
      hide-url: true
{% if alert_types %}
    alerts:
{% for alert_type in alert_types %}
      - type: {{ alert_type }}
        description: "Runner {{ runner.name }} on {{ runner.host }} stopped checking in to GitLab — its CI jobs will queue. Expect up to ~2h of detection latency; if it stays down, inspect the runner service on {{ runner.host }}."
        send-on-resolved: {{ gatus_alert_send_on_resolved | string | lower }}
{% endfor %}
{% endif %}
{% endfor %}

{% for endpoint in gatus_endpoints %}
  - name: "{{ endpoint.name }}"
    group: {{ endpoint.group }}
    url: "{{ endpoint.url }}"
    interval: {{ endpoint.interval | default(gatus_default_interval) }}
    conditions:
      - "[STATUS] == {{ endpoint.status }}"
{% if alert_types %}
    alerts:
{% for alert_type in alert_types %}
      - type: {{ alert_type }}
        description: "{{ endpoint.description | default(endpoint.name ~ ' is not responding as expected') }}"
        send-on-resolved: {{ gatus_alert_send_on_resolved | string | lower }}
{% endfor %}
{% endif %}
{% endfor %}

  # Wildcard certificate runway. Traefik renews *.atelier.house over the
  # Cloudflare DNS challenge; this catches a renewal that quietly stopped
  # working while there is still time to fix it by hand.
  - name: TLS certificate
    group: core
    url: "https://git.atelier.house/"
    interval: 1h
    conditions:
      - "[CERTIFICATE_EXPIRATION] > {{ gatus_cert_warning_hours }}h"
{% if alert_types %}
    alerts:
{% for alert_type in alert_types %}
      - type: {{ alert_type }}
        description: "Wildcard certificate *.atelier.house is inside {{ gatus_cert_warning_hours }}h of expiry — Traefik's Cloudflare DNS-challenge renewal has stopped. Renew manually before it lapses."
        send-on-resolved: {{ gatus_alert_send_on_resolved | string | lower }}
{% endfor %}
{% endif %}
{% if gatus_push_token | length > 0 and gatus_host_report_hosts | length > 0 %}

# Pushed by each host's reporter; see gatus_host_report_checks in defaults.
external-endpoints:
{% for host in gatus_host_report_hosts %}
{% for check in gatus_host_report_checks %}
  - name: "{{ host }} {{ check.id | replace('-', ' ') }}"
    group: {{ gatus_host_report_group }}
    token: "${GATUS_PUSH_TOKEN}"
{% if check.heartbeat is defined %}
    heartbeat:
      interval: {{ check.heartbeat }}
{% endif %}
{% if alert_types %}
    alerts:
{% for alert_type in alert_types %}
      - type: {{ alert_type }}
        description: "{{ check.description | replace('{host}', host) }}"
        failure-threshold: {{ check.failure_threshold }}
        success-threshold: {{ check.success_threshold }}
        send-on-resolved: {{ check.send_on_resolved | string | lower }}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
