# {{ ansible_managed }}
name: {{ stack_name }}

services:
  slskd:
    image: {{ slskd_image }}
    container_name: slskd
    restart: {{ restart_policy }}
    # All traffic leaves through the gluetun stack's tunnel. gluetun publishes
    # the web UI and carries the slskd alias on the shared network. Peers
    # reach the Soulseek listener through the port gluetun forwards.
    network_mode: container:gluetun
    env_file:
      - ./env/slskd.env
    environment:
      - TZ={{ timezone }}
      - PUID={{ puid }}
      - PGID={{ pgid }}
      - SLSKD_SLSK_LISTEN_PORT={{ slskd_listen_port }}
    volumes:
      - ./config:/app
      - music:/music:ro
      - downloads:/downloads
    healthcheck:
      # The second check fails when the tunnel is down or this container was
      # left in a namespace gluetun no longer owns.
      test: ["CMD-SHELL", "wget --spider -q http://localhost:5030/health && wget -q -O /dev/null http://127.0.0.1:9999"]
      interval: {{ healthcheck_interval }}
      timeout: {{ healthcheck_timeout }}
      retries: {{ healthcheck_retries }}
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

volumes:
  music:
    name: music
    external: true
  downloads:
    name: downloads
    external: true
