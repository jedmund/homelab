# {{ ansible_managed }}
# Inbox Zero environment - generated from Ansible Vault.
# Shared by inboxzero-web, inboxzero-worker, and inboxzero-cron.

# Core
NEXT_PUBLIC_BASE_URL={{ inboxzero_base_url }}
DATABASE_URL={{ inboxzero_database_url }}
DIRECT_URL={{ inboxzero_database_url }}
INTERNAL_API_URL=http://inboxzero-web:{{ inboxzero_port }}

# Auth
AUTH_SECRET={{ inboxzero_auth_secret }}
EMAIL_ENCRYPT_SECRET={{ inboxzero_email_encrypt_secret }}
EMAIL_ENCRYPT_SALT={{ inboxzero_email_encrypt_salt }}
INTERNAL_API_KEY={{ inboxzero_internal_api_key }}
{% if inboxzero_api_key_salt %}
API_KEY_SALT={{ inboxzero_api_key_salt }}
{% endif %}
ADMINS={{ inboxzero_admin_emails }}
AUTH_ALLOWED_EMAILS={{ inboxzero_allowed_emails }}
SSO_LOGIN_ENABLED={{ inboxzero_sso_enabled }}
AUTO_JOIN_ORGANIZATION_ENABLED={{ inboxzero_auto_join_org }}

# Google OAuth (Gmail API + account login)
GOOGLE_CLIENT_ID={{ inboxzero_google_client_id }}
GOOGLE_CLIENT_SECRET={{ inboxzero_google_client_secret }}
GOOGLE_PUBSUB_TOPIC_NAME={{ inboxzero_google_pubsub_topic_name }}
GOOGLE_PUBSUB_VERIFICATION_TOKEN={{ inboxzero_google_pubsub_verification_token }}

# Redis: HTTP proxy for cache/rate limits, native URL for the BullMQ queue.
# 2.30.0 reads the UPSTASH_* names (REDIS_HTTP_* arrives in later releases).
UPSTASH_REDIS_URL={{ inboxzero_redis_http_url }}
UPSTASH_REDIS_TOKEN={{ inboxzero_redis_http_token }}
REDIS_URL={{ inboxzero_redis_url }}
QUEUE_BACKEND={{ inboxzero_queue_backend }}

# LLMs via Open WebUI (OpenAI-compatible); 2.30.0 legacy provider/model style.
# Omitting ECONOMY/CHAT/DRAFT provider vars makes them fall back to default.
LLM_API_KEY={{ inboxzero_openwebui_api_key }}
DEFAULT_LLM_PROVIDER={{ inboxzero_llm_provider }}
DEFAULT_LLM_MODEL={{ inboxzero_llm_default_model }}
NANO_LLM_PROVIDER={{ inboxzero_llm_provider }}
NANO_LLM_MODEL={{ inboxzero_llm_nano_model }}
OPENAI_COMPATIBLE_BASE_URL={{ inboxzero_llm_base_url }}
OPENAI_COMPATIBLE_MODEL={{ inboxzero_llm_default_model }}
NEXT_PUBLIC_AI_MODEL_SETTINGS_DISABLED={{ inboxzero_lock_model_settings }}

# Transactional email (Resend)
{% if inboxzero_resend_api_key %}
RESEND_API_KEY={{ inboxzero_resend_api_key }}
RESEND_FROM_EMAIL={{ inboxzero_resend_from_email }}
NEXT_PUBLIC_IS_RESEND_CONFIGURED=true
{% endif %}

# Scheduled-task bearer token (inboxzero-cron uses it)
CRON_SECRET={{ inboxzero_cron_secret }}

# Feature flags
NEXT_PUBLIC_BYPASS_PREMIUM_CHECKS={{ inboxzero_bypass_premium_checks }}
NEXT_PUBLIC_EMAIL_SEND_ENABLED={{ inboxzero_email_send_enabled }}
NEXT_PUBLIC_CONTACTS_ENABLED={{ inboxzero_contacts_enabled }}
NEXT_PUBLIC_INTEGRATIONS_ENABLED={{ inboxzero_integrations_enabled }}
NEXT_PUBLIC_WEBHOOK_ACTION_ENABLED=true
NEXT_PUBLIC_EXTERNAL_API_ENABLED={{ inboxzero_external_api_enabled }}
{% if inboxzero_resend_api_key %}
NEXT_PUBLIC_DIGEST_ENABLED={{ inboxzero_digest_enabled }}
NEXT_PUBLIC_MEETING_BRIEFS_ENABLED={{ inboxzero_meeting_briefs_enabled }}
NEXT_PUBLIC_FOLLOW_UP_REMINDERS_ENABLED={{ inboxzero_follow_up_reminders_enabled }}
{% endif %}
