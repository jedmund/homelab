# {{ ansible_managed }}
# phpBB application environment. Contains install-time credentials; deployed
# with mode 0600 and treated as secret input.

TZ={{ timezone }}

PHPBB_VERSION="{{ phpbb_version }}"

PHPBB_DBMS="mysqli"
PHPBB_DB_HOST="{{ phpbb_db_host }}"
PHPBB_DB_PORT="{{ phpbb_db_port }}"
PHPBB_DB_USER="{{ phpbb_db_user }}"
PHPBB_DB_PASSWORD="{{ phpbb_db_password }}"
PHPBB_DB_NAME="{{ phpbb_db_name }}"
PHPBB_DB_TABLE_PREFIX="{{ phpbb_db_table_prefix }}"

PHPBB_ADMIN_NAME="{{ phpbb_admin_name }}"
PHPBB_ADMIN_PASSWORD="{{ phpbb_admin_password }}"
PHPBB_ADMIN_EMAIL="{{ phpbb_admin_email }}"

PHPBB_BOARD_NAME="{{ phpbb_board_name }}"
PHPBB_BOARD_DESCRIPTION="{{ phpbb_board_description }}"
PHPBB_DEFAULT_LANG="{{ phpbb_default_lang }}"
PHPBB_BOARD_EMAIL="{{ phpbb_board_email }}"

PHPBB_EMAIL_ENABLED="{{ phpbb_email_enabled }}"
PHPBB_SMTP_DELIVERY="{{ phpbb_smtp_delivery }}"
PHPBB_SMTP_HOST="{{ phpbb_smtp_host }}"
PHPBB_SMTP_PORT="{{ phpbb_smtp_port }}"
PHPBB_SMTP_AUTH_METHOD="{{ phpbb_smtp_auth_method }}"
PHPBB_SMTP_USERNAME="{{ phpbb_smtp_username }}"
PHPBB_SMTP_PASSWORD="{{ phpbb_smtp_password }}"

PHPBB_COOKIE_SECURE="{{ phpbb_cookie_secure }}"
PHPBB_SERVER_PROTOCOL="{{ phpbb_server_protocol }}"
PHPBB_SERVER_NAME="{{ phpbb_server_name }}"
PHPBB_SERVER_PORT="{{ phpbb_server_port }}"
PHPBB_SCRIPT_PATH="{{ phpbb_script_path }}"

PHPBB_PHP_UPLOAD_MAX_FILESIZE="{{ phpbb_php_upload_max_filesize }}"
PHPBB_PHP_POST_MAX_SIZE="{{ phpbb_php_post_max_size }}"
PHPBB_PHP_MEMORY_LIMIT="{{ phpbb_php_memory_limit }}"
PHPBB_PHP_MAX_EXECUTION_TIME="{{ phpbb_php_max_execution_time }}"
PHPBB_PHP_MAX_INPUT_TIME="{{ phpbb_php_max_input_time }}"
PHPBB_PHP_PM_MAX_CHILDREN="{{ phpbb_php_pm_max_children }}"
PHPBB_PHP_PM_START_SERVERS="{{ phpbb_php_pm_start_servers }}"
PHPBB_PHP_PM_MIN_SPARE_SERVERS="{{ phpbb_php_pm_min_spare_servers }}"
PHPBB_PHP_PM_MAX_SPARE_SERVERS="{{ phpbb_php_pm_max_spare_servers }}"
