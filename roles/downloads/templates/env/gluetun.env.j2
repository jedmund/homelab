# {{ ansible_managed }}
# Gluetun environment variables

VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY={{ gluetun_wireguard_private_key }}
WIREGUARD_ADDRESSES={{ gluetun_wireguard_addresses }}
SERVER_COUNTRIES={{ gluetun_vpn_server_countries }}
# Proton forwards ports only on its P2P servers
PORT_FORWARD_ONLY=on
VPN_PORT_FORWARDING=on
VPN_PORT_FORWARDING_PORTS_COUNT={{ gluetun_forwarded_ports_count }}
{% if gluetun_firewall_outbound_subnets | length > 0 %}
FIREWALL_OUTBOUND_SUBNETS={{ gluetun_firewall_outbound_subnets | join(',') }}
{% endif %}
HTTP_CONTROL_SERVER_ADDRESS={{ gluetun_control_server_address }}
# slskd polls the control server every few seconds
HTTP_CONTROL_SERVER_LOG=off
TZ={{ timezone }}
