      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "avg by (index)(netdata_nvidia_smi_gpu_utilization{job=\"netdata-gpu\",index=~\"$gpu\"})",
          "editorMode": "code",
