    },
    {
      "id": 7,
      "title": "95th percentile time to first token",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "histogram_quantile(0.95,sum by (le,model_name)(rate(vllm:time_to_first_token_seconds_bucket{job=\"vllm\",model_name=~\"$model\"}[$__rate_interval])))",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "{{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
