          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "sum by (model_name,finished_reason)(rate(vllm:request_success_total{job=\"vllm\",model_name=~\"$model\"}[$__rate_interval]))",
          "editorMode": "code",
