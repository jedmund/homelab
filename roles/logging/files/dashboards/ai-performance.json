    {
      "id": 15,
      "title": "llama-swap API calls per second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "homelab-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "homelab-loki"
          },
          "expr": "sum(rate({host=\"max\",collector=\"vector\",container=\"llama-swap\"} |= \"[INFO] Request\" |= `\"POST /v1/`[5m]))",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Proxy access-log responses; not a count of completed model generations."
    },
    {
      "id": 16,
      "title": "llama-swap 95th percentile request duration",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "homelab-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "homelab-loki"
          },
          "expr": "quantile_over_time(0.95,{host=\"max\",collector=\"vector\",container=\"llama-swap\"} |= \"[INFO] Request\" |= `\"POST /v1/` | regexp `Request [^ ]+ \"POST (?P<path>[^ ]+) HTTP/[^\\\"]+\" (?P<status>[0-9]{3}) [0-9]+ \"[^\\\"]*\" (?P<latency>[0-9.]+[[:alpha:]\u00b5]+)` | keep path,latency | unwrap duration_seconds(latency) | __error__=\"\" [5m]) by (path)",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Model counters and latency histograms currently come from **vLLM / GLM-5.3-Flash**. llama-swap API panels use its proxy access logs; token counters for other llama.cpp models are not inferred. GPU metrics come from the existing Netdata parent and include all three physical GPU indexes. Metrics history begins when Prometheus starts collecting; idle models can have zero throughput or no latency samples."
      }
    }
  ]
}
