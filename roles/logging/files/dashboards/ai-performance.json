          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "sum by (model_name)(rate(vllm:generation_tokens_total{job=\"vllm\",model_name=~\"$model\"}[$__rate_interval]))",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "{{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "t/s",
          "color": {
            "mode": "palette-classic"
