{
  "uid": "homelab-ai-performance",
  "title": "AI workload performance",
  "description": "vLLM model serving, llama-swap proxy access, and all three GPUs on max.",
  "tags": [
    "homelab",
    "managed"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "link",
      "title": "Log browser",
      "url": "/d/homelab-log-browser",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Web traffic",
      "url": "/d/homelab-web-traffic",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "AI performance",
      "url": "/d/homelab-ai-performance",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Network",
      "url": "/d/homelab-unifi-network",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Hosts",
      "url": "/d/homelab-host-capacity",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Storage & backups",
      "url": "/d/homelab-storage-backups",
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "vLLM model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-prometheus"
        },
        "query": "label_values(vllm:num_requests_running, model_name)",
        "definition": "label_values(vllm:num_requests_running, model_name)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "gpu",
        "label": "GPU index",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-prometheus"
        },
        "query": "label_values(netdata_nvidia_smi_gpu_utilization, index)",
        "definition": "label_values(netdata_nvidia_smi_gpu_utilization, index)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Running requests",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "sum(vllm:num_requests_running{job=\"vllm\",model_name=~\"$model\"})",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "{{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Queued requests",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "sum(vllm:num_requests_waiting{job=\"vllm\",model_name=~\"$model\"})",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "{{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Generated tokens / second",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "sum(rate(vllm:generation_tokens_total{job=\"vllm\",model_name=~\"$model\"}[$__rate_interval]))",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "{{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "t/s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
