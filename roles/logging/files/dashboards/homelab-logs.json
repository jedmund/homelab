{
  "uid": "homelab-log-browser",
  "title": "Homelab log browser",
  "description": "Browse retained application and host logs. Counts reflect collected entries, not unique incidents.",
  "tags": [
    "homelab",
    "managed"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "link",
      "title": "Log browser",
      "url": "/d/homelab-log-browser",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Web traffic",
      "url": "/d/homelab-web-traffic",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "AI performance",
      "url": "/d/homelab-ai-performance",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Network",
      "url": "/d/homelab-unifi-network",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Hosts",
      "url": "/d/homelab-host-capacity",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Storage & backups",
      "url": "/d/homelab-storage-backups",
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "homelab-loki"
        },
        "query": "label_values(host)",
        "definition": "label_values(host)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "homelab-loki"
        },
        "query": "label_values({host=~\"$host\"}, service_name)",
        "definition": "label_values({host=~\"$host\"}, service_name)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "homelab-loki"
        },
        "query": "label_values({host=~\"$host\"}, job)",
        "definition": "label_values({host=~\"$host\"}, job)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "search",
        "label": "Search regex",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Case-sensitive regular expression; use (?i) for case-insensitive matching.",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Collected entries",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "homelab-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "homelab-loki"
          },
          "expr": "sum(count_over_time({host=~\"$host\",service_name=~\"$service\",job=~\"$source\"} |~ `${search:raw}` | keep host,service_name,job[$__range])) or vector(0)",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Error-pattern matches",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "homelab-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "homelab-loki"
          },
          "expr": "sum(count_over_time({host=~\"$host\",service_name=~\"$service\",job=~\"$source\"} |~ `${search:raw}` | keep host,service_name,job |~ `(?i)(error|fatal|panic|exception)` [$__range])) or vector(0)",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Text matches can include handled errors or quoted messages. Inspect the actual entry."
    },
    {
      "id": 3,
      "title": "Reporting hosts",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "homelab-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "homelab-loki"
          },
          "expr": "count(sum by (host)(count_over_time({host=~\"$host\",service_name=~\"$service\",job=~\"$source\"} |~ `${search:raw}` | keep host,service_name,job[$__range]))) or vector(0)",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Log volume by host",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "homelab-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "homelab-loki"
          },
          "expr": "sum by (host)(count_over_time({host=~\"$host\",service_name=~\"$service\",job=~\"$source\"} |~ `${search:raw}` | keep host,service_name,job[$__interval]))",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Log volume by service",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "homelab-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "homelab-loki"
          },
          "expr": "topk(10,sum by (service_name)(count_over_time({host=~\"$host\",service_name=~\"$service\",job=~\"$source\"} |~ `${search:raw}` | keep host,service_name,job[$__range])))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      }
    },
    {
      "id": 6,
      "title": "Recent matching logs",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "homelab-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "homelab-loki"
          },
          "expr": "{host=~\"$host\",service_name=~\"$service\",job=~\"$source\"} |~ `${search:raw}`",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 7,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Use the filters above to narrow the stream. Open a log entry for its labels and filename. **Search is a regular expression.** Time shown is the event timestamp when parsed; other file sources may use collection time. Existing application logs may contain user content."
      }
    }
  ]
}
