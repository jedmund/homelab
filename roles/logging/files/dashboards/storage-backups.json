          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "{{host}} \u00b7 {{name}} \u00b7 {{pool_id}} used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "unpoller_unas_pool_capacity_bytes{job=\"unas\",host=~\"$nas\"}",
          "editorMode": "code",
          "instant": false,
