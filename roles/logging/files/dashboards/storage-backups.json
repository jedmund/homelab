    },
    {
      "id": 12,
      "title": "Pool growth per day (6-hour trend)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "deriv(unpoller_unas_pool_usage_bytes{job=\"unas\",host=~\"$nas\"}[6h]) * 86400",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "{{host}} \u00b7 {{name}} \u00b7 {{pool_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "A short-term linear trend; deletions and maintenance can make it negative. More history improves interpretation."
    },
    {
      "id": 13,
      "title": "Estimated days of remaining pool capacity",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "((unpoller_unas_pool_capacity_bytes{job=\"unas\",host=~\"$nas\"} - unpoller_unas_pool_usage_bytes{job=\"unas\",host=~\"$nas\"}) / (deriv(unpoller_unas_pool_usage_bytes{job=\"unas\",host=~\"$nas\"}[6h]) > 0) / 86400) and (count_over_time(unpoller_unas_pool_usage_bytes{job=\"unas\",host=~\"$nas\"}[6h]) >= 60)",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "{{host}} \u00b7 {{name}} \u00b7 {{pool_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Linear forecast for growing pools with at least 60 samples (about one hour). Flat/decreasing usage or insufficient history produces no estimate."
    },
