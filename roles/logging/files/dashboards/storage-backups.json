        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "RAID redundancy shortfall",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "clamp_min(unpoller_unas_raid_group_expected_protection{job=\"unas\",host=~\"$nas\"} - unpoller_unas_raid_group_current_protection{job=\"unas\",host=~\"$nas\"},0)",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "{{host}} \u00b7 {{name}} \u00b7 {{pool_id}} \u00b7 {{raid_group_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Zero means reported redundancy meets the configured expectation. Missing metrics mean unknown, not healthy."
    },
