{
  "uid": "homelab-storage-backups",
  "title": "Storage and backup health",
  "description": "UNAS pool/disk health and verified Borg backup, NAS mirror and restore freshness.",
  "tags": [
    "homelab",
    "managed"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "link",
      "title": "Log browser",
      "url": "/d/homelab-log-browser",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Web traffic",
      "url": "/d/homelab-web-traffic",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "AI performance",
      "url": "/d/homelab-ai-performance",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Network",
      "url": "/d/homelab-unifi-network",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Hosts",
      "url": "/d/homelab-host-capacity",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Storage & backups",
      "url": "/d/homelab-storage-backups",
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "nas",
        "label": "NAS",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-prometheus"
        },
        "query": "label_values(unpoller_unas_device_present, host)",
        "definition": "label_values(unpoller_unas_device_present, host)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Reporting NAS consoles",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "count(unpoller_unas_device_present{job=\"unas\",host=~\"$nas\"}) or vector(0)",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}} \u00b7 {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Backup verification passed",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "homelab_backup_verification_ok unless homelab_backup_repository_busy == 1",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}} \u00b7 {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "Passed",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Verifies archive freshness, matching local/NAS archive IDs, Core artifacts and Minecraft snapshot freshness. Check repository-busy state before interpreting a failure."
    },
    {
      "id": 3,
      "title": "Newest local Borg archive age",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "time() - homelab_backup_borg_archive_timestamp_seconds",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}} \u00b7 {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Newest local archive successfully read by Borg. Matching NAS mirror and complete backup verification are reported separately."
    },
    {
      "id": 4,
      "title": "Last successful Prowlarr restore proof",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "time() - homelab_backup_restore_timestamp_seconds",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}} \u00b7 {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Proof covers one restored Prowlarr SQLite dump; it does not prove every service can be restored. Missing means no recorded proof."
    },
    {
      "id": 5,
      "title": "Storage pool utilization",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "expr": "100 * unpoller_unas_pool_usage_bytes{job=\"unas\",host=~\"$nas\"} / unpoller_unas_pool_capacity_bytes{job=\"unas\",host=~\"$nas\"}",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "{{host}} \u00b7 {{name}} \u00b7 {{pool_id}} \u00b7 {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Pool capacity / used bytes",
