; {{ ansible_managed }}
[server]
root_url = https://{{ logging_domain }}
[analytics]
reporting_enabled = false
check_for_updates = false
[dashboards]
default_home_dashboard_path = /var/lib/grafana/dashboards/homelab-logs.json
[auth]
disable_login_form = true
[auth.basic]
enabled = false
[auth.anonymous]
enabled = false
[auth.proxy]
enabled = false
[auth.generic_oauth]
enabled = true
name = PocketID
allow_sign_up = true
auto_login = true
scopes = openid profile email groups
auth_url = {{ logging_oidc_issuer }}/authorize
token_url = {{ logging_oidc_issuer }}/api/oidc/token
api_url = {{ logging_oidc_issuer }}/api/oidc/userinfo
use_pkce = true
validate_id_token = true
jwk_set_url = {{ logging_oidc_issuer }}/.well-known/jwks.json
login_attribute_path = preferred_username
email_attribute_path = email
name_attribute_path = name
groups_attribute_path = groups
allowed_groups = {{ logging_oidc_allowed_group }}
role_attribute_path = contains(groups[*], '{{ logging_oidc_allowed_group }}') && 'Admin'
role_attribute_strict = true
allow_assign_grafana_admin = false
[users]
allow_sign_up = false
auto_assign_org_role = Viewer
[security]
cookie_secure = true
cookie_samesite = lax
[log]
mode = console
