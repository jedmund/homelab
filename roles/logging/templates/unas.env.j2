# {{ ansible_managed }}
UP_INFLUXDB_DISABLE=true
UP_PROMETHEUS_DISABLE=false
UP_PROMETHEUS_HTTP_LISTEN=0.0.0.0:9130
UP_UNIFI_DISABLE=true
UP_UNAS_ENABLE=true
UP_UNAS_DEVICE_0_URL=https://unifi.local
UP_UNAS_DEVICE_0_USER={{ logging_unas_username }}
UP_UNAS_DEVICE_0_PASS={{ logging_unas_password }}
UP_UNAS_DEVICE_0_VERIFY_SSL=true
SSL_CERT_FILE=/etc/unpoller/controller.crt
