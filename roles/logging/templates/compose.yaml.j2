# {{ ansible_managed }}
name: {{ stack_name }}

services:
  loki:
    image: {{ logging_loki_image }}
    container_name: logging-loki
    restart: {{ restart_policy }}
    command: ["-config.file=/etc/loki/config.yaml", "-config.expand-env=true"]
    env_file: ./env/storage.env
    ports:
      - "127.0.0.1:{{ logging_query_port }}:3100"
    volumes:
      - ./config/loki.yaml:/etc/loki/config.yaml:ro
      - ./loki-state:/var/lib/loki
    networks: [default, ingress]
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

  garage:
    image: {{ logging_garage_image }}
    container_name: logging-garage
    user: "{{ puid }}:{{ pgid }}"
    restart: {{ restart_policy }}
    volumes:
      - ./config/garage.toml:/etc/garage.toml:ro
      - ./garage-meta:/var/lib/garage/meta
      - type: bind
        source: {{ logging_nas_directory }}/garage
        target: /var/lib/garage/data
        bind:
          create_host_path: false
    networks: [default]
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

  gateway:
    image: {{ logging_gateway_image }}
    container_name: logging-gateway
    restart: {{ restart_policy }}
    ports:
      - "{{ logging_bind_address }}:{{ logging_ingest_port }}:8443"
    volumes:
      - ./config/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./tls/server.crt:/etc/nginx/tls/server.crt:ro
      - ./tls/server.key:/etc/nginx/tls/server.key:ro
      - ./tls/ca.crt:/etc/nginx/tls/ca.crt:ro
    networks: [default, ingress]
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

  grafana:
    image: {{ logging_grafana_image }}
    container_name: logging-grafana
    restart: {{ restart_policy }}
    env_file: ./env/grafana.env
    volumes:
      - ./grafana-data:/var/lib/grafana
      - ./config/grafana.ini:/etc/grafana/grafana.ini:ro
      - ./config/datasources.yaml:/etc/grafana/provisioning/datasources/logging.yaml:ro
    networks: [default, proxy]
    labels:
      traefik.enable: "true"
      traefik.docker.network: "{{ proxy_network }}"
      traefik.http.routers.logging.rule: "Host(`{{ logging_domain }}`)"
      traefik.http.routers.logging.entrypoints: websecure
      traefik.http.routers.logging.tls.certresolver: letsencrypt
      traefik.http.services.logging.loadbalancer.server.port: "3000"
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

  checks:
    image: {{ logging_checks_image }}
    container_name: logging-checks
    restart: {{ restart_policy }}
    command: ["python", "/app/checks.py"]
    environment:
      EXPECTED_HOSTS: '{{ logging_expected_hosts | to_json }}'
      HEARTBEAT_MAX_AGE: "{{ logging_heartbeat_max_age }}"
      NAS_SERVER: "{{ nas_server }}"
      NAS_WARNING_PERCENT: "{{ logging_nas_warning_percent }}"
    volumes:
      - ./scripts/checks.py:/app/checks.py:ro
      - ./backup:/backup:ro
      - type: bind
        source: {{ logging_nas_directory }}
        target: /nas
        read_only: true
        bind:
          create_host_path: false
    networks: [default, proxy]
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/live', timeout=3)"]
      interval: 30s
      timeout: 5s
      retries: 3
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

networks:
  default:
    internal: true
  # Docker does not publish ports for containers attached only to internal
  # networks. The gateway and loopback administrative API join it.
  ingress: {}
  proxy:
    name: {{ proxy_network }}
    external: true
