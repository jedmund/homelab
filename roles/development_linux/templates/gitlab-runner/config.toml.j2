# {{ ansible_managed }}
# GitLab Runner config (max, docker executor). Owned by Ansible; the
# runner does not write back to this file outside `register`/`verify`,
# and we never call those - the auth tokens come from vault directly.

concurrent = {{ gitlab_runner_linux_concurrent }}
check_interval = 0
log_level = "{{ gitlab_runner_linux_log_level }}"
shutdown_timeout = 0

[session_server]
  session_timeout = 1800

{# Both runner entries share everything except identity and resource caps, so
   they render from one definition and cannot drift apart. #}
{% macro docker_runner(name, token, limit, cpus, memory, tmpfs_size) %}
[[runners]]
  name = "{{ name }}"
  url = "{{ gitlab_runner_linux_url }}/"
  clone_url = "{{ gitlab_runner_linux_url }}"
  id = 0
  token = "{{ token }}"
  token_obtained_at = 1970-01-01T00:00:00Z
  token_expires_at = 0001-01-01T00:00:00Z
  executor = "docker"
  limit = {{ limit }}
  [runners.cache]
{% if gitlab_cache_s3_access_key_id | length > 0 %}
    # Distributed cache on the isolated CI Garage (nuc-mini). Shared = true so
    # cache keys are not runner-scoped and the nuc-mini + max runners reuse
    # each other's archives. Config in group_vars/compute_servers/ci_cache.yml.
    Type = "s3"
    Shared = true
{% endif %}
    MaxUploadedArchiveSize = 0
    [runners.cache.s3]
{% if gitlab_cache_s3_access_key_id | length > 0 %}
      ServerAddress = "{{ gitlab_cache_s3_lan_endpoint }}"
      AccessKey = "{{ gitlab_cache_s3_access_key_id }}"
      SecretKey = "{{ gitlab_cache_s3_secret_access_key }}"
      BucketName = "{{ gitlab_cache_s3_bucket }}"
      BucketLocation = "{{ gitlab_cache_s3_region }}"
      Insecure = {{ gitlab_cache_s3_insecure | ternary('true', 'false') }}
{% endif %}
    [runners.cache.gcs]
    [runners.cache.azure]
  [runners.docker]
    tls_verify = false
    image = "{{ gitlab_runner_linux_default_image }}"
    privileged = false
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    # The docker executor has two independent cache layers. The distributed
    # one (the [runners.cache] S3 block above) is what `cache:` in a
    # .gitlab-ci.yml actually uses, and it has its own expiry. The local one
    # backs unmapped container paths like /cache below with named Docker
    # volumes -- and GitLab Runner never deletes those, so it accumulates one
    # volume per (runner, project, concurrent slot, cache key) forever. That
    # had reached 84 orphaned volumes / 127 GB on nuc-mini and 106 volumes /
    # 55 GB on max. Disabling it makes those volumes ephemeral (removed with
    # the job) rather than persistent; the distributed cache already provides
    # the reuse the local layer was duplicating.
    disable_cache = true
    network_mode = "{{ cibuild_network }}"
    volumes = ["/var/run/docker.sock:/var/run/docker.sock", "/cache"]
    shm_size = 0
    network_mtu = 0
    # Per-job resource caps. Absent these, one runaway job can consume the
    # whole box; with them the worst case across all concurrent jobs is
    # bounded by the CI budget in roles/development_linux/defaults.
    cpus = "{{ cpus }}"
    memory = "{{ memory }}"
    # RAM-backed /tmp; see gitlab_runner_linux_tmpfs_size in defaults.
    tmpfs = {"/tmp" = "rw,exec,mode=1777,size={{ tmpfs_size }}"}
    extra_hosts = [{% for h in gitlab_runner_linux_extra_hosts %}"{{ h }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endmacro %}
{{ docker_runner(gitlab_runner_linux_name, gitlab_runner_linux_auth_token, gitlab_runner_linux_limit, gitlab_runner_linux_cpus, gitlab_runner_linux_memory, gitlab_runner_linux_tmpfs_size) }}
{% if gitlab_runner_linux_large_auth_token | length > 0 %}

{{ docker_runner(gitlab_runner_linux_large_name, gitlab_runner_linux_large_auth_token, gitlab_runner_linux_large_limit, gitlab_runner_linux_large_cpus, gitlab_runner_linux_large_memory, gitlab_runner_linux_large_tmpfs_size) }}
{% endif %}
