# {{ ansible_managed }}
{% if netdata_role == 'parent' %}
[db]
    mode = dbengine
    storage tiers = 3
    dbengine tier 0 retention time = {{ netdata_tier0_retention }}
    dbengine tier 1 retention time = {{ netdata_tier1_retention }}
    dbengine tier 2 retention time = {{ netdata_tier2_retention }}
    dbengine tier 0 retention size = {{ netdata_tier0_size }}
    dbengine tier 1 retention size = {{ netdata_tier1_size }}
    dbengine tier 2 retention size = {{ netdata_tier2_size }}

[web]
    bind to = *
{% endif %}
{% if ansible_facts['os_family'] == 'Darwin' %}
[logs]
    # apps.plugin emits a warning per process per collection cycle on macOS
    # ("pid N <name> states parent 1, but the later does not exist"), a benign
    # quirk of how it reads parent PIDs there. At the default info level that
    # wrote roughly 490 MB a day and had grown collector.log to 11.2 GB before
    # anyone noticed. Errors still come through.
    level = error

[plugins]
    # apps.plugin cannot do its job here. Homebrew runs netdata as an
    # unprivileged user agent, ndsudo is not setuid-root, and macOS refuses
    # per-process task info without elevation, so the plugin collects nothing
    # and logs a failure per process per cycle. Turning it off removes the
    # remaining log volume without losing data we were actually getting.
    apps = no
{% endif %}
