# {{ ansible_managed }}
name: {{ stack_name }}

services:
  mongo:
    image: {{ komodo_mongo_image }}
    container_name: komodo_mongo
    labels:
      komodo.skip: # Prevent Komodo from stopping with StopAllContainers
    command: --quiet --wiredTigerCacheSizeGB 0.25
    restart: {{ restart_policy }}
    networks:
      - backend
    env_file: ./env/mongo.env
    volumes:
      - mongo-data:/data/db
      - mongo-config:/data/configdb
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: {{ healthcheck_interval }}
      timeout: {{ healthcheck_timeout }}
      retries: {{ healthcheck_retries }}
      start_period: 40s
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

  komodo-core:
    image: ghcr.io/moghtech/komodo-core:{{ komodo_image_tag }}
    container_name: komodo_core
    init: true
    labels:
      komodo.skip: # Prevent Komodo from stopping with StopAllContainers
    restart: {{ restart_policy }}
    depends_on:
      mongo:
        condition: service_healthy
    networks:
      - backend
      - shared
    ports:
      - 9120:9120
    env_file: ./env/komodo.env
    volumes:
      - komodo-keys:/config/keys
      - {{ config_base }}/backups:/backups
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

  komodo-periphery:
    image: ghcr.io/moghtech/komodo-periphery:{{ komodo_image_tag }}
    container_name: komodo_periphery
    init: true
    labels:
      komodo.skip: # Prevent Komodo from stopping with StopAllContainers
    restart: {{ restart_policy }}
    depends_on:
      - komodo-core
    networks:
      - backend
      # Periphery runs the registry queries behind CheckStackForUpdate itself,
      # from inside the container, rather than delegating them to the daemon.
      # backend is internal: true, so on that network alone every check fails
      # with "lookup <registry>: server misbehaving". It needs egress.
      - shared
    env_file: ./env/komodo.env
    environment:
      # The Docker CLI keeps writable state next to config.json: it creates
      # $DOCKER_CONFIG/buildx on invocation. Binding the credential directory
      # to the default /root/.docker read-only therefore made every
      # CheckStackForUpdate fail with
      #   mkdir /root/.docker/buildx: read-only file system
      # Point DOCKER_CONFIG at the credential directory on the read-write
      # {{ periphery_root_directory }} mount instead. This does not widen the
      # container's access: that mount already exposes the same config.json
      # read-write, so the :ro bind was never an effective restriction.
      DOCKER_CONFIG: {{ periphery_registry_config_directory }}
    volumes:
      - komodo-keys:/config/keys
      - /var/run/docker.sock:/var/run/docker.sock
      - /proc:/proc
      - {{ periphery_root_directory }}:{{ periphery_root_directory }}
      - {{ docker_base_path }}:{{ docker_base_path }}:ro
      - /home/{{ ansible_user }}/Docker:/home/{{ ansible_user }}/Docker
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

volumes:
  komodo-keys:
    name: komodo-keys
  mongo-data:
    name: komodo-mongo-data
    external: true
  mongo-config:
    name: komodo-mongo-config
    external: true

networks:
  backend:
    name: {{ backend_network }}
    internal: true
  shared:
    name: {{ shared_network }}
    external: true
