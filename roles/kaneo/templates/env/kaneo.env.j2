# {{ ansible_managed }}
# Kaneo application environment - generated from Ansible defaults and Vault

# Public URLs
KANEO_CLIENT_URL={{ kaneo_client_url }}
KANEO_API_URL={{ kaneo_api_url }}

# GitLab SCM integration
GITLAB_PUBLIC_URL={{ kaneo_gitlab_public_url }}
GITLAB_INTERNAL_URL={{ kaneo_gitlab_internal_url }}
GITLAB_OAUTH_CLIENT_ID={{ kaneo_gitlab_oauth_client_id }}
GITLAB_OAUTH_CLIENT_SECRET={{ kaneo_gitlab_oauth_client_secret }}
SCM_SECRET_ENCRYPTION_KEY={{ kaneo_scm_secret_encryption_key }}

# PostgreSQL. The bundled Kaneo entrypoint derives and URL-encodes DATABASE_URL.
POSTGRES_HOST={{ kaneo_db_host }}
POSTGRES_PORT={{ kaneo_db_port }}
POSTGRES_DB={{ kaneo_db_name }}
POSTGRES_USER={{ kaneo_db_user }}
POSTGRES_PASSWORD={{ kaneo_db_password }}

# Redis Pub/Sub
REDIS_URL={{ kaneo_redis_url }}

# Authentication
AUTH_SECRET={{ kaneo_auth_secret }}
DISABLE_GUEST_ACCESS={{ kaneo_disable_guest_access }}
DISABLE_REGISTRATION={{ kaneo_disable_registration }}
DISABLE_PASSWORD_REGISTRATION={{ kaneo_disable_password_registration }}
DISABLE_LOGIN_FORM={{ kaneo_disable_login_form }}
CUSTOM_OAUTH_AUTO_LOGIN={{ kaneo_custom_oauth_auto_login }}

# PocketID custom OIDC provider
CUSTOM_OAUTH_CLIENT_ID={{ kaneo_oidc_client_id }}
CUSTOM_OAUTH_CLIENT_SECRET={{ kaneo_oidc_client_secret }}
CUSTOM_OAUTH_AUTHORIZATION_URL={{ kaneo_oidc_authorization_url }}
CUSTOM_OAUTH_TOKEN_URL={{ kaneo_oidc_token_url }}
CUSTOM_OAUTH_USER_INFO_URL={{ kaneo_oidc_user_info_url }}
CUSTOM_OAUTH_DISCOVERY_URL={{ kaneo_oidc_discovery_url }}
CUSTOM_OAUTH_LOGOUT_URL={{ kaneo_oidc_logout_url }}
CUSTOM_OAUTH_SCOPES={{ kaneo_oidc_scopes }}
CUSTOM_OAUTH_RESPONSE_TYPE={{ kaneo_oidc_response_type }}
CUSTOM_AUTH_PKCE={{ kaneo_oidc_pkce }}

# SendGrid SMTP
SMTP_HOST={{ kaneo_smtp_host }}
SMTP_PORT={{ kaneo_smtp_port }}
SMTP_SECURE={{ kaneo_smtp_secure }}
SMTP_REQUIRE_TLS={{ kaneo_smtp_require_tls }}
SMTP_IGNORE_TLS={{ kaneo_smtp_ignore_tls }}
SMTP_USER={{ kaneo_smtp_user }}
SMTP_PASSWORD={{ kaneo_smtp_password }}
SMTP_FROM={{ kaneo_smtp_from }}

# GitHub App repository integration. GitHub sign-in remains disabled.
GITHUB_APP_ID={{ kaneo_github_app_id }}
GITHUB_APP_NAME={{ kaneo_github_app_name }}
GITHUB_WEBHOOK_SECRET={{ kaneo_github_webhook_secret }}
GITHUB_PRIVATE_KEY_BASE64={{ kaneo_github_private_key_base64 }}

# Object storage (Garage): private image/attachment uploads. The browser
# uploads directly to S3_ENDPOINT via presigned URLs, so it must be the public
# Traefik route (not the internal kaneo-garage:3900). The bucket stays private;
# files are served back only through the API.
S3_ENDPOINT={{ kaneo_garage_public_endpoint }}
S3_BUCKET={{ kaneo_garage_bucket }}
S3_ACCESS_KEY_ID={{ kaneo_garage_access_key_id }}
S3_SECRET_ACCESS_KEY={{ kaneo_garage_secret_access_key }}
S3_REGION={{ kaneo_garage_region }}
S3_FORCE_PATH_STYLE=true

{% if kaneo_agent_inspections_enabled %}
AGENT_SERVICE_ENCRYPTION_KEY={{ kaneo_agent_service_encryption_key }}
AGENT_SERVICE_ALLOWED_ORIGINS={{ kaneo_agent_service_allowed_origins }}
{% endif %}
