# {{ ansible_managed }}
# HuggingHack app config. Container paths (/models, /data) are fixed and
# match the volume mounts in compose. Secrets come from the vault.

APP_NAME=HuggingHack
TZ={{ timezone }}

# Storage. Filesystem backend writes to /models (NAS Files share).
MODEL_STORAGE=/models
MODEL_STORAGE_BACKEND=filesystem
DATA_DIR=/data
DATABASE_URL={{ hugginghack_database_url }}

# Hugging Face
# The container runs as a numeric non-root UID without a passwd entry. Give
# libraries an explicit writable home/cache instead of letting expanduser()
# fall back to /.cache.
HOME=/data
XDG_CACHE_HOME=/data/.cache
HF_HOME=/data/.cache/huggingface
HF_ENDPOINT={{ hugginghack_hf_endpoint }}
HF_TOKEN={{ hugginghack_hf_token }}
HF_HUB_DISABLE_TELEMETRY=1
MAX_CONCURRENT_DOWNLOADS={{ hugginghack_max_concurrent_downloads }}
DOWNLOAD_WORKERS_PER_JOB={{ hugginghack_download_workers_per_job }}

# Native PocketID OIDC. PocketID's client allow-list is the primary access
# gate; app-level group lists are optional additional policy.
AUTH_MODE={{ hugginghack_auth_mode }}
APP_BASE_URL={{ hugginghack_app_base_url }}
SECURE_COOKIES={{ hugginghack_secure_cookies | lower }}
SESSION_TTL_HOURS={{ hugginghack_session_ttl_hours }}
OIDC_PROVIDER_NAME={{ hugginghack_oidc_provider_name }}
OIDC_ISSUER={{ hugginghack_oidc_issuer }}
OIDC_CLIENT_ID={{ hugginghack_oidc_client_id }}
OIDC_CLIENT_SECRET={{ hugginghack_oidc_client_secret }}
OIDC_SCOPES={{ hugginghack_oidc_scopes | join(',') }}
OIDC_ALLOWED_GROUPS={{ hugginghack_oidc_allowed_groups | join(',') }}
OIDC_ADMIN_GROUPS={{ hugginghack_oidc_admin_groups | join(',') }}
OIDC_SESSION_TTL_HOURS={{ hugginghack_oidc_session_ttl_hours }}

# Uploads
UPLOAD_CHUNK_MB={{ hugginghack_upload_chunk_mb }}
MAX_UPLOAD_SIZE_GB={{ hugginghack_max_upload_size_gb }}
