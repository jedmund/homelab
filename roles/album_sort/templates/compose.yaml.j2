# {{ ansible_managed }}
name: {{ stack_name }}

services:
  album-sort:
    container_name: album_sort
    image: "{{ album_sort_image }}:{{ album_sort_image_tag }}"
    pull_policy: always
    restart: {{ restart_policy }}
    env_file:
      - ./env/album-sort.env
    environment:
      TZ: "{{ timezone }}"
      NODE_ENV: production
      APP_BASE_URL: "{{ album_sort_origin }}"
      ORIGIN: "{{ album_sort_origin }}"
      AUTH_REQUIRED: "{{ album_sort_auth_required }}"
      SORT_MUTATIONS_ENABLED: "{{ album_sort_mutations_enabled }}"
      OIDC_ISSUER_URL: "{{ album_sort_oidc_issuer_url }}"
      SESSION_TTL_HOURS: "{{ album_sort_session_ttl_hours }}"
      UNSORTED_PATH: "{{ album_sort_unsorted_path }}"
      SORTED_PATH: "{{ album_sort_sorted_path }}"
      DATA_PATH: "{{ album_sort_data_path }}"
      WATCH_INTERVAL: "{{ album_sort_watch_interval }}"
      SCAN_CONCURRENCY: "{{ album_sort_scan_concurrency }}"
      MUSICBRAINZ_BASE_URL: "{{ album_sort_musicbrainz_base_url }}"
      COVER_ART_ARCHIVE_BASE_URL: "{{ album_sort_cover_art_archive_base_url }}"
      BEETS_WEB_URL: http://beets:8337
      BEETS_API_URL: http://beets:8338
      OPENSUBSONIC_TRACE_PATH: "{{ album_sort_opensubsonic_trace_path }}"
      TRUSTED_PROXY_CIDRS: "{{ album_sort_trusted_proxy_cidrs }}"
    volumes:
      - music:/music
      - ./data:/data
    depends_on:
      beets:
        condition: service_healthy
    networks:
      - proxy
      - shared
      - backend
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    labels:
      traefik.enable: "true"
      traefik.docker.network: "{{ proxy_network }}"
      traefik.http.routers.album-sort.rule: "Host(`{{ album_sort_domain }}`)"
      traefik.http.routers.album-sort.entrypoints: websecure
      traefik.http.routers.album-sort.tls.certresolver: letsencrypt
{% if album_sort_use_tinyauth %}
      traefik.http.routers.album-sort.middlewares: tinyauth@file
{% endif %}
{% if album_sort_expose_rest_api %}
      traefik.http.routers.album-sort-rest.rule: "Host(`{{ album_sort_domain }}`) && PathPrefix(`/rest`)"
      traefik.http.routers.album-sort-rest.entrypoints: websecure
      traefik.http.routers.album-sort-rest.tls.certresolver: letsencrypt
      traefik.http.routers.album-sort-rest.priority: "100"
      traefik.http.routers.album-sort-rest.service: album-sort
{% endif %}
      traefik.http.services.album-sort.loadbalancer.server.port: "{{ album_sort_container_port }}"
      traefik.http.services.album-sort.loadbalancer.healthcheck.path: /healthz
      traefik.http.services.album-sort.loadbalancer.healthcheck.interval: 30s
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

  beets:
    container_name: album_sort_beets
    image: "{{ album_sort_beets_image }}:{{ album_sort_image_tag }}"
    pull_policy: always
    restart: {{ restart_policy }}
    environment:
      TZ: "{{ timezone }}"
      MUSIC_SORTED_PATH: "{{ album_sort_sorted_path }}"
    volumes:
      - music:/music:ro
      - ./beets-data:/data/beets
    networks:
      - backend
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

volumes:
  music:
    external: true

networks:
  proxy:
    name: {{ proxy_network }}
    external: true
  shared:
    name: {{ shared_network }}
    external: true
  backend:
    internal: true
