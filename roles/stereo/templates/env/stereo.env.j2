# {{ ansible_managed }}
APPLE_MUSIC_TEAM_ID={{ stereo_apple_music_team_id }}
APPLE_MUSIC_KEY_ID={{ stereo_apple_music_key_id }}
APPLE_MUSIC_PRIVATE_KEY={{ stereo_apple_music_private_key }}
DISCOGS_TOKEN={{ stereo_discogs_token }}
LASTFM_API_KEY={{ stereo_lastfm_api_key | default('') }}
MULTI_SCROBBLER_URL={{ stereo_multi_scrobbler_url }}
OIDC_CLIENT_ID={{ stereo_oidc_client_id }}
OIDC_CLIENT_SECRET={{ stereo_oidc_client_secret }}
USER_SECRET_ENCRYPTION_KEY={{ stereo_user_secret_encryption_key }}
# Read only by the Postgres build; the SQLite-era app ignores it.
DATABASE_URL=postgres://{{ stereo_postgres_user }}:{{ stereo_postgres_password | urlencode | replace('/', '%2F') }}@stereo_postgres:5432/{{ stereo_postgres_db }}
