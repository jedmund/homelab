# {{ ansible_managed }}
name: {{ stack_name }}

services:
  # kibble — see roles/kibble/defaults/main.yml for the
  # `network_mode: host` rationale.  No traefik labels: routing is
  # handled by the file provider in
  # roles/infra_gateway/templates/traefik/dynamic/services-mini.yml.j2
  # (search for `kibble` there).
  kibble:
    container_name: kibble
    image: "{{ kibble_image }}:{{ kibble_image_tag }}"
    restart: {{ restart_policy }}
    network_mode: host
    # Distroless `nonroot` (uid 65532) needs CAP_NET_BIND_SERVICE to
    # bind the ONVIF SOAP listeners on port 80 (one per feeder VIP).
    # Without it the binary boots fine on 8554/8555/18080 but
    # ListenAndServe on :80 fails with "permission denied".
    cap_add:
      - NET_BIND_SERVICE
    env_file:
      - ./env/kibble.env
    volumes:
      - ./config/{{ data_name }}:/data
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}
{% if kibble_garage_rpc_secret | length > 0 %}

  # kibble's own Garage — private S3 for cat profile photos,
  # deliberately separate from kizuna's instance so the two stacks
  # deploy independently. The S3 API is published on host loopback
  # only: the kibble service above is network_mode: host and can't
  # resolve compose-network hostnames, so it dials
  # http://127.0.0.1:{{ kibble_garage_s3_port }}; nothing off-host
  # can reach the bound port. Bucket + access key are created by
  # ./garage_bootstrap.sh (one-time, prints the key for the vault).
  kibble-garage:
    container_name: kibble-garage
    image: {{ kibble_garage_image }}
    restart: {{ restart_policy }}
    ports:
      - "127.0.0.1:{{ kibble_garage_s3_port }}:3900"
    volumes:
      - ./config/garage/garage.toml:/etc/garage.toml:ro
      - kibble-garage-data:/var/lib/garage/data
      - kibble-garage-meta:/var/lib/garage/meta
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

volumes:
  # Reuse the existing Garage volumes from the pre-rename feederhub stack so the
  # cat-photo bucket carries over without a migration. external + explicit name
  # bypasses the compose project prefix (which would otherwise be kibble_*).
  kibble-garage-data:
    external: true
    name: {{ data_name }}_{{ data_name }}-garage-data
  kibble-garage-meta:
    external: true
    name: {{ data_name }}_{{ data_name }}-garage-meta
{% endif %}
