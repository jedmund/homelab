# {{ ansible_managed }}
# kibble environment.  Mirror of /Users/justin/Developer/PetLibro/
# kibble/.env.example with values injected from role defaults and
# group_vars/kibble/vault.yml.

KIBBLE_LISTEN=:{{ kibble_host_port }}
KIBBLE_LOG_LEVEL=info
KIBBLE_DB_PATH=/data/{{ data_name }}.db
KIBBLE_TIMEZONE={{ timezone }}

# MQTT — petlibro-mosquitto publishes on the host's 0.0.0.0:1883,
# and kibble runs with `network_mode: host`, so loopback works.
KIBBLE_MQTT_URL=tcp://127.0.0.1:1883

# Topic prefixes — these are fixed by the PLAF203 firmware.
KIBBLE_HA_DISCOVERY_PREFIX=homeassistant
KIBBLE_PETLIBRO_TOPIC_PREFIX=dl/PLAF203
KIBBLE_BRIDGE_PREFIX=kibble

# Tuning — defaults proven during the Phase 3 + 4 smoke runs.
KIBBLE_HANDSHAKE_DEBOUNCE_MS=2000
KIBBLE_NTP_SYNC_THRESHOLD_MS=5000
KIBBLE_CALIBRATION_TOLERANCE_MS=200

# Authentication — OIDC via PocketID. Issuer + client id + redirect
# URL enable auth (the server fails fast on a partial set, so this
# block renders all-or-nothing on the vault client id). The single
# public client covers both the server's BFF PKCE flow and the iOS
# app's own PKCE flow; SECRET and NATIVE_CLIENT_ID are emitted only
# if a confidential/split-client setup is ever vaulted.
{% if kibble_oidc_client_id | length > 0 %}
KIBBLE_OIDC_ISSUER={{ kibble_oidc_issuer }}
KIBBLE_OIDC_CLIENT_ID={{ kibble_oidc_client_id }}
{% if kibble_oidc_client_secret | length > 0 %}
KIBBLE_OIDC_CLIENT_SECRET={{ kibble_oidc_client_secret }}
{% endif %}
KIBBLE_OIDC_REDIRECT_URL={{ kibble_oidc_redirect_url }}
{% if kibble_oidc_native_client_id | length > 0 %}
KIBBLE_OIDC_NATIVE_CLIENT_ID={{ kibble_oidc_native_client_id }}
{% endif %}
{% endif %}

# Cat-photo storage — this stack's own Garage (kibble-garage),
# reached over host loopback since kibble is network_mode: host.
# Rendered only when the vault holds the access key so a pre-bootstrap
# deploy leaves the photo endpoints cleanly disabled (503) instead of
# failing fast on a partial KIBBLE_S3_* group.
{% if kibble_s3_access_key_id | length > 0 %}
KIBBLE_S3_ENDPOINT={{ kibble_s3_endpoint }}
KIBBLE_S3_BUCKET={{ kibble_s3_bucket }}
KIBBLE_S3_REGION={{ kibble_s3_region }}
KIBBLE_S3_ACCESS_KEY_ID={{ kibble_s3_access_key_id }}
KIBBLE_S3_SECRET_ACCESS_KEY={{ kibble_s3_secret_access_key }}
{% endif %}

# TUTK (Kalay) master-server endpoint + creds.
{% if kibble_kalay_enabled | bool %}
# In-process Kalay is ON — leave TUTK_SERVER blank so kibble dials
# its own 127.0.0.1:10001 listener (config.loadKalay default).
KIBBLE_TUTK_SERVER=
{% else %}
KIBBLE_TUTK_SERVER={{ kibble_tutk_server }}
{% endif %}
KIBBLE_TUTK_USERNAME={{ kibble_tutk_username }}
KIBBLE_TUTK_PASSWORD={{ kibble_tutk_password }}

# In-process Kalay master (internal/kalay).  When enabled kibble
# binds UDP 10001 + 10240 and impersonates ThroughTek's cloud so the
# feeders register locally — no external kalay-mock unit required.
# HOST_LAN_IP is the nuc's LAN address, advertised to feeders and used
# as the PUNCH_TO2 source.
KIBBLE_KALAY_ENABLED={{ kibble_kalay_enabled | string | lower }}
KIBBLE_KALAY_BIND={{ kibble_kalay_bind }}
KIBBLE_KALAY_HOST_LAN_IP={{ kibble_kalay_host_lan_ip }}

# Feeders inventory — `device_id:uid:name` triples, comma-separated.
KIBBLE_FEEDERS={{ kibble_feeders }}

# Seed the Kalay registry with each feeder's LAN IP (`uid:ip` pairs) so
# GET_RIP answers immediately on boot rather than after the first
# KEEPALIVE.  UIDs must match those in KIBBLE_FEEDERS above.
KIBBLE_FEEDER_IPS={% for f in kibble_feeder_ips %}{{ f.uid }}:{{ f.ip }}{% if not loop.last %},{% endif %}{% endfor %}

# Cloud bridge — off.  The whole point of kibble is that the
# Petlibro app's cloud session continues to work AS LONG AS the
# UDM DNAT keeps redirecting the device-side MQTT to our broker.
# HOST/PORT/CREDS_FILE are only read when the bridge is enabled.
KIBBLE_CLOUD_BRIDGE_ENABLED={{ kibble_cloud_bridge_enabled | string | lower }}
KIBBLE_CLOUD_HOST={{ kibble_cloud_host }}
KIBBLE_CLOUD_PORT={{ kibble_cloud_port }}
KIBBLE_CLOUD_CREDS_FILE={{ kibble_cloud_creds_file }}

# ONVIF Profile-S responder — one LAN VIP per feeder at port 80.
# VIPs are added to {{ kibble_onvif_bridge }} by the role's
# "ensure kibble ONVIF VIPs" task.  Container needs
# cap_add: NET_BIND_SERVICE (set in compose.yaml.j2) to bind port 80
# as the distroless nonroot user.
KIBBLE_ONVIF_ENABLED={{ kibble_onvif_enabled | string | lower }}
KIBBLE_ONVIF_USER={{ kibble_onvif_user }}
KIBBLE_ONVIF_PASS={{ kibble_onvif_pass }}
KIBBLE_ONVIF_PORT={{ kibble_onvif_port }}
KIBBLE_ONVIF_BIND_IPS={{ kibble_onvif_bind_ips | join(',') }}
KIBBLE_ONVIF_ADVERTISE_HOST={{ kibble_onvif_advertise_host }}
