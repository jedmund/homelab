# {{ ansible_managed }}
name: {{ stack_name }}

services:
  gluetun:
    image: {{ gluetun_image }}
    container_name: gluetun
    restart: {{ restart_policy }}
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    networks:
      - vpn
    env_file:
      - ./env/gluetun.env
    volumes:
      - ./config:/gluetun
    healthcheck:
      # Gluetun's own check reports whether the tunnel is up. The control
      # server's routes need authentication, so they can't serve as a probe.
      test: ["CMD", "/gluetun-entrypoint", "healthcheck"]
      interval: {{ healthcheck_interval }}
      timeout: {{ healthcheck_timeout }}
      retries: {{ healthcheck_retries }}
      start_period: {{ healthcheck_start_period }}
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

networks:
  vpn:
    name: vpn-network
    internal: false
