# {{ ansible_managed }}
name: {{ stack_name }}

services:
  # Shared VPN for the download clients. qBittorrent, SABnzbd, and slskd run
  # in their own stacks with network_mode container:gluetun, so this container
  # carries their aliases and published ports.
  gluetun:
    image: {{ gluetun_image }}
    container_name: gluetun
    restart: {{ restart_policy }}
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    networks:
      shared:
        aliases:
{% for alias in gluetun_shared_aliases %}
          - {{ alias }}
{% endfor %}
    ports:
{% for port in gluetun_published_ports %}
      - "{{ port.host }}:{{ port.container }}"
{% endfor %}
    env_file:
      - ./env/gluetun.env
    volumes:
      - ./config:/gluetun
    healthcheck:
      # Gluetun's own check reports whether the tunnel is up.
      test: ["CMD", "/gluetun-entrypoint", "healthcheck"]
      interval: {{ healthcheck_interval }}
      timeout: {{ healthcheck_timeout }}
      retries: {{ healthcheck_retries }}
      start_period: {{ healthcheck_start_period }}
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

networks:
  shared:
    name: {{ shared_network }}
    external: true
