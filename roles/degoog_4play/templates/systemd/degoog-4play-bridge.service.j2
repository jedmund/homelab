# {{ ansible_managed }}
[Unit]
Description=Degoog 4play local WebSocket bridge
Wants=network-online.target
After=network-online.target
Conflicts=nginx.service

[Service]
Type=simple
RuntimeDirectory=degoog-4play
RuntimeDirectoryMode=0750
# Let the Firefox user traverse the shared runtime directory for Xauthority.
ExecStartPre=/usr/bin/install -d -o root -g {{ degoog_4play_group }} -m 0750 /run/degoog-4play
ExecStartPre=/usr/sbin/nginx -t -c /etc/degoog-4play/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/degoog-4play/nginx.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -t -c /etc/degoog-4play/nginx.conf
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
