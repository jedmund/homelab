# {{ ansible_managed }}
name: {{ stack_name }}

services:
  degoog:
    container_name: degoog
    image: {{ degoog_image }}
    restart: {{ restart_policy }}
    networks:
      - proxy
    ports:
      # Local provisioning and the native 4play bridge only.
      - "127.0.0.1:{{ degoog_port }}:4444"
    labels:
      traefik.enable: "true"
      traefik.docker.network: "{{ proxy_network }}"
      traefik.http.routers.degoog.rule: "Host(`{{ degoog_base_url | urlsplit('hostname') }}`)"
      traefik.http.routers.degoog.entrypoints: websecure
      traefik.http.routers.degoog.tls.certresolver: letsencrypt
      traefik.http.routers.degoog.middlewares: tinyauth@file
      traefik.http.services.degoog.loadbalancer.server.port: "4444"
    env_file:
      - ./env/degoog.env
    environment:
      DEGOOG_BASE_URL: "{{ degoog_base_url }}"
      DEGOOG_DISTRUST_PROXY: "{{ degoog_distrust_proxy }}"
      DEGOOG_PUBLIC_INSTANCE: "{{ degoog_public_instance }}"
      PUID: "{{ degoog_puid }}"
      PGID: "{{ degoog_pgid }}"
    volumes:
      - ./data:/app/data
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:4444/readyz"]
      interval: {{ healthcheck_interval }}
      timeout: {{ healthcheck_timeout }}
      retries: {{ healthcheck_retries }}
      start_period: {{ healthcheck_start_period }}
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

networks:
  proxy:
    name: {{ proxy_network }}
    external: true
