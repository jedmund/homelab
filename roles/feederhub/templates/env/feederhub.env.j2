# {{ ansible_managed }}
# feederhub environment.  Mirror of /Users/justin/Developer/PetLibro/
# feederhub/.env.example with values injected from role defaults and
# group_vars/feederhub/vault.yml.

FEEDERHUB_LISTEN=:{{ feederhub_host_port }}
FEEDERHUB_LOG_LEVEL=info
FEEDERHUB_DB_PATH=/data/feederhub.db
FEEDERHUB_TIMEZONE={{ timezone }}

# MQTT — petlibro-mosquitto publishes on the host's 0.0.0.0:1883,
# and feederhub runs with `network_mode: host`, so loopback works.
FEEDERHUB_MQTT_URL=tcp://127.0.0.1:1883

# Topic prefixes — these are fixed by the PLAF203 firmware.
FEEDERHUB_HA_DISCOVERY_PREFIX=homeassistant
FEEDERHUB_PETLIBRO_TOPIC_PREFIX=dl/PLAF203
FEEDERHUB_BRIDGE_PREFIX=feederhub

# Tuning — defaults proven during the Phase 3 + 4 smoke runs.
FEEDERHUB_HANDSHAKE_DEBOUNCE_MS=2000
FEEDERHUB_NTP_SYNC_THRESHOLD_MS=5000
FEEDERHUB_CALIBRATION_TOLERANCE_MS=200

# Cat-photo storage — this stack's own Garage (feederhub-garage),
# reached over host loopback since feederhub is network_mode: host.
# Rendered only when the vault holds the access key so a pre-bootstrap
# deploy leaves the photo endpoints cleanly disabled (503) instead of
# failing fast on a partial FEEDERHUB_S3_* group.
{% if feederhub_s3_access_key_id | length > 0 %}
FEEDERHUB_S3_ENDPOINT={{ feederhub_s3_endpoint }}
FEEDERHUB_S3_BUCKET={{ feederhub_s3_bucket }}
FEEDERHUB_S3_REGION={{ feederhub_s3_region }}
FEEDERHUB_S3_ACCESS_KEY_ID={{ feederhub_s3_access_key_id }}
FEEDERHUB_S3_SECRET_ACCESS_KEY={{ feederhub_s3_secret_access_key }}
{% endif %}

# TUTK (Kalay) master-server endpoint + creds.
{% if feederhub_kalay_enabled | bool %}
# In-process Kalay is ON — leave TUTK_SERVER blank so feederhub dials
# its own 127.0.0.1:10001 listener (config.loadKalay default).
FEEDERHUB_TUTK_SERVER=
{% else %}
FEEDERHUB_TUTK_SERVER={{ feederhub_tutk_server }}
{% endif %}
FEEDERHUB_TUTK_USERNAME={{ feederhub_tutk_username }}
FEEDERHUB_TUTK_PASSWORD={{ feederhub_tutk_password }}

# In-process Kalay master (internal/kalay).  When enabled feederhub
# binds UDP 10001 + 10240 and impersonates ThroughTek's cloud so the
# feeders register locally — no external kalay-mock unit required.
# HOST_LAN_IP is the nuc's LAN address, advertised to feeders and used
# as the PUNCH_TO2 source.
FEEDERHUB_KALAY_ENABLED={{ feederhub_kalay_enabled | string | lower }}
FEEDERHUB_KALAY_BIND={{ feederhub_kalay_bind }}
FEEDERHUB_KALAY_HOST_LAN_IP={{ feederhub_kalay_host_lan_ip }}

# Feeders inventory — `device_id:uid:name` triples, comma-separated.
FEEDERHUB_FEEDERS={{ feederhub_feeders }}

# Seed the Kalay registry with each feeder's LAN IP (`uid:ip` pairs) so
# GET_RIP answers immediately on boot rather than after the first
# KEEPALIVE.  UIDs must match those in FEEDERHUB_FEEDERS above.
FEEDERHUB_FEEDER_IPS={% for f in feederhub_feeder_ips %}{{ f.uid }}:{{ f.ip }}{% if not loop.last %},{% endif %}{% endfor %}

# Cloud bridge — off.  The whole point of feederhub is that the
# Petlibro app's cloud session continues to work AS LONG AS the
# UDM DNAT keeps redirecting the device-side MQTT to our broker.
# HOST/PORT/CREDS_FILE are only read when the bridge is enabled.
FEEDERHUB_CLOUD_BRIDGE_ENABLED={{ feederhub_cloud_bridge_enabled | string | lower }}
FEEDERHUB_CLOUD_HOST={{ feederhub_cloud_host }}
FEEDERHUB_CLOUD_PORT={{ feederhub_cloud_port }}
FEEDERHUB_CLOUD_CREDS_FILE={{ feederhub_cloud_creds_file }}

# ONVIF Profile-S responder — one LAN VIP per feeder at port 80.
# VIPs are added to {{ feederhub_onvif_bridge }} by the role's
# "ensure feederhub ONVIF VIPs" task.  Container needs
# cap_add: NET_BIND_SERVICE (set in compose.yaml.j2) to bind port 80
# as the distroless nonroot user.
FEEDERHUB_ONVIF_ENABLED={{ feederhub_onvif_enabled | string | lower }}
FEEDERHUB_ONVIF_USER={{ feederhub_onvif_user }}
FEEDERHUB_ONVIF_PASS={{ feederhub_onvif_pass }}
FEEDERHUB_ONVIF_PORT={{ feederhub_onvif_port }}
FEEDERHUB_ONVIF_BIND_IPS={{ feederhub_onvif_bind_ips | join(',') }}
FEEDERHUB_ONVIF_ADVERTISE_HOST={{ feederhub_onvif_advertise_host }}
