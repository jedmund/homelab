# {{ ansible_managed }}
name: {{ stack_name }}

services:
  sabnzbd:
    image: {{ sabnzbd_image }}
    container_name: sabnzbd
    restart: {{ restart_policy }}
    # All traffic leaves through the gluetun stack's tunnel. gluetun publishes
    # port 8080 as host port 8085 and carries the sabnzbd alias on the shared
    # network.
    network_mode: container:gluetun
    environment:
      - TZ={{ timezone }}
      - PUID={{ puid }}
      - PGID={{ pgid }}
    volumes:
      - ./config:/config
      - {{ sabnzbd_incomplete_path }}:/incomplete
      - downloads:/downloads
    healthcheck:
      # The second check fails when the tunnel is down or this container was
      # left in a namespace gluetun no longer owns.
      test: ["CMD-SHELL", "curl -fsS -o /dev/null 'http://localhost:8080/api?mode=version' && curl -fsS -o /dev/null http://127.0.0.1:9999"]
      interval: {{ healthcheck_interval }}
      timeout: {{ healthcheck_timeout }}
      retries: {{ healthcheck_retries }}
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

volumes:
  downloads:
    name: downloads
    external: true
