# {{ ansible_managed }}
# Widget compiler sidecar (Node). Called by kizuna-api's AiWidgetJob over the
# backend network at http://kizuna-widget-compiler:4100 (/catalog, /compile).

# Listen port — must match the port kizuna-api targets via WIDGET_COMPILER_URL.
PORT=4100

# Shared secret checked against the API's X-Widget-Compiler-Secret header.
# Must equal WIDGET_COMPILER_SECRET in api.env. Blank disables the check.
WIDGET_COMPILER_SECRET={{ kizuna_widget_compiler_secret }}
