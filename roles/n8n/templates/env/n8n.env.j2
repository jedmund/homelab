# {{ ansible_managed }}
# n8n environment variables

# Database
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST={{ n8n_db_host }}
DB_POSTGRESDB_PORT={{ n8n_db_port }}
DB_POSTGRESDB_DATABASE={{ n8n_db_name }}
DB_POSTGRESDB_USER={{ n8n_db_user }}
DB_POSTGRESDB_PASSWORD={{ n8n_db_password }}

# Server
N8N_HOST={{ n8n_domain }}
N8N_PORT={{ n8n_port }}
N8N_PROTOCOL={{ n8n_protocol }}
WEBHOOK_URL={{ n8n_webhook_url }}
N8N_USER_MANAGEMENT_DISABLED={{ n8n_user_management_disabled }}
N8N_PROXY_HOPS={{ n8n_proxy_hops }}

# Encryption key
{% if n8n_encryption_key is defined %}
N8N_ENCRYPTION_KEY={{ n8n_encryption_key }}
{% endif %}

# Fork-only patch: unlocks enterprise features (OIDC SSO, Sharing,
# Log Streaming, Environments, External Secrets, Project Roles) without
# a license. All feature config is set via the in-app settings UI.
N8N_ENABLE_SELF_HOSTED_FEATURES={{ n8n_self_hosted_features_enabled }}

# n8n Assistant (instance-ai). The module is on by default in 2.x; naming it
# here is additive (n8n merges N8N_ENABLED_MODULES with its default set) and
# keeps the dependency visible next to the settings that feed it.
N8N_ENABLED_MODULES=instance-ai

# Model: local weights on max, reached through Open WebUI's OpenAI-compatible
# API as the "n8n Assistant" user. A bare model name (no provider/ prefix) is
# what a custom endpoint expects.
N8N_INSTANCE_AI_MODEL={{ n8n_instance_ai_model }}
N8N_INSTANCE_AI_MODEL_URL={{ n8n_instance_ai_model_url }}
# n8n_instance_ai_model_api_key - defined in vault
N8N_INSTANCE_AI_MODEL_API_KEY={{ n8n_instance_ai_model_api_key }}

# Code sandbox. Required: without it the Assistant can talk but cannot build
# workflows, since it assembles them from SDK source it writes and runs.
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_SANDBOX_SERVICE_URL={{ n8n_sandbox_service_url }}
# n8n_sandbox_api_key - defined in vault, must match SANDBOX_API_KEYS on sandbox-api
N8N_SANDBOX_SERVICE_API_KEY={{ n8n_sandbox_api_key }}

# Web search, optional: the ai stack's SearXNG on max. No key needed.
N8N_INSTANCE_AI_SEARXNG_URL={{ n8n_instance_ai_searxng_url }}
