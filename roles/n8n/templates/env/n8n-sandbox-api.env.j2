# {{ ansible_managed }}
# n8n Sandbox Service: control plane secrets
#
# Each secret is one side of a pair. n8n presents a key from SANDBOX_API_KEYS
# as N8N_SANDBOX_SERVICE_API_KEY; the runner presents the registration token
# to join; the API presents the runner key when calling back into the runner.
# A mismatch surfaces as an auth failure when the Assistant first runs code,
# not at startup.

# n8n_sandbox_api_key - defined in vault
SANDBOX_API_KEYS={{ n8n_sandbox_api_key }}
# n8n_sandbox_registration_token - defined in vault
SANDBOX_API_RUNNER_REGISTRATION_TOKEN={{ n8n_sandbox_registration_token }}
# n8n_sandbox_runner_api_key - defined in vault
SANDBOX_API_RUNNER_API_KEY={{ n8n_sandbox_runner_api_key }}
