# {{ ansible_managed }}
name: {{ stack_name }}

services:
  n8n:
    container_name: n8n
    image: {{ n8n_image }}
    restart: {{ restart_policy }}
    networks:
      - proxy
      - backend
      - sandbox
    volumes:
      - n8n-data:/home/node/.n8n
    env_file:
      - ./env/n8n.env
    depends_on:
      n8n-db:
        condition: service_healthy
    labels:
      traefik.enable: "true"
      traefik.http.routers.n8n.rule: "Host(`{{ n8n_domain }}`)"
      traefik.http.routers.n8n.entrypoints: "websecure"
      traefik.http.routers.n8n.tls.certresolver: "letsencrypt"
      traefik.http.services.n8n.loadbalancer.server.port: "{{ n8n_port }}"
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

  n8n-db:
    container_name: n8n_postgres
    image: {{ n8n_db_image }}
    restart: {{ restart_policy }}
    networks:
      - backend
    volumes:
      - n8n-pgdata:/var/lib/postgresql/data
    env_file:
      - ./env/n8n-db.env
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "{{ n8n_db_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: "5m"
        max-file: {{ logging_max_file }}

  # n8n Assistant code sandbox, below. The three services talk to each other
  # over mutual TLS on a stack-local network and publish nothing: n8n reaches
  # sandbox-api by service name, and sandbox-api reaches the runner the same
  # way. The certificates are issued for the SANs `sandbox-api` and
  # `sandbox-runner-1`, so those two service names are load-bearing; renaming
  # either one means regenerating the `n8n-sandbox-tls` volume.
  #
  # One-shot: mints the CA and the four leaf certs into the shared volume,
  # then exits. Everything else waits for it to complete. The certs do not
  # auto-renew; to reissue, delete the volume and redeploy.
  sandbox-certs:
    container_name: n8n_sandbox_certs
    image: {{ n8n_sandbox_api_image }}
    restart: "no"
    user: "0:0"
    entrypoint: ["sh", "-c"]
    command:
      - >
        bootstrap-mtls.sh --out-dir /tls --api-san sandbox-api
        --control-san-prefix sandbox-runner --world-readable &&
        chown -R sandbox-api:sandbox-api /tls/api && chmod -R a+rX /tls
    environment:
      NUM_RUNNERS: "1"
    networks:
      - sandbox
    volumes:
      - n8n-sandbox-tls:/tls
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: "5m"
        max-file: {{ logging_max_file }}

  # Control plane. n8n posts code-execution requests here over plain HTTP
  # inside the stack network, authenticated with an API key; the API places
  # each sandbox on a registered runner and proxies to it over mTLS.
  sandbox-api:
    container_name: n8n_sandbox_api
    image: {{ n8n_sandbox_api_image }}
    restart: {{ restart_policy }}
    networks:
      - sandbox
    volumes:
      - n8n-sandbox-tls:/tls:ro
      - n8n-sandbox-api-data:/var/lib/n8n-sandbox-api
    env_file:
      - ./env/n8n-sandbox-api.env
    environment:
      SANDBOX_API_GRPC_TLS_CERT_FILE: /tls/api/grpc-server.crt
      SANDBOX_API_GRPC_TLS_KEY_FILE: /tls/api/grpc-server.key
      SANDBOX_API_GRPC_TLS_CLIENT_CA_FILE: /tls/api/ca.crt
      SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_CA_FILE: /tls/api/ca.crt
      SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_CERT_FILE: /tls/api/control-grpc-api-client.crt
      SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_KEY_FILE: /tls/api/control-grpc-api-client.key
      SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_SERVER_NAME: sandbox-runner-1
    depends_on:
      sandbox-certs:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:8080/healthz"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

  # The runner hosts the actual sandboxes: it runs its own dockerd and starts
  # one container per Assistant thread. That needs privileged mode, so treat
  # this container as root on nuc-mini: no published ports, no Traefik labels,
  # nothing else on its network. Upstream's unprivileged alternative is the
  # sysbox-runc runtime, which would have to be installed on the host first.
  sandbox-runner-1:
    container_name: n8n_sandbox_runner_1
    image: {{ n8n_sandbox_runner_image }}
    restart: {{ restart_policy }}
    privileged: true
    networks:
      - sandbox
    volumes:
      - n8n-sandbox-tls:/tls:ro
      # Image store for the inner dockerd. Upstream keeps this in the
      # container's own layer and re-pulls the sandbox image whenever the
      # runner is replaced; this role recreates containers on every deploy,
      # so give it somewhere to persist.
      - n8n-sandbox-dind:/var/lib/docker
    env_file:
      - ./env/n8n-sandbox-runner.env
    environment:
      SANDBOX_RUNNER_ID: runner-1
      SANDBOX_RUNNER_API_GRPC_ADDR: sandbox-api:9090
      # Plain HTTP: on 1.2.0 this listener does not serve TLS, and the API
      # verifies nothing about it beyond reaching it. Both ends of the pair
      # that does use mTLS are the gRPC ports below.
      SANDBOX_RUNNER_HTTP_BASE_URL: http://sandbox-runner-1:8080
      SANDBOX_RUNNER_CONTROL_GRPC_LISTEN_ADDR: ":9091"
      SANDBOX_RUNNER_CONTROL_GRPC_ADVERTISE_ADDR: sandbox-runner-1:9091
      SANDBOX_RUNNER_DOCKER_SANDBOX_IMAGE: {{ n8n_sandbox_image }}
      SANDBOX_RUNNER_REGISTRATION_GRPC_CA_FILE: /tls/runner/ca.crt
      SANDBOX_RUNNER_REGISTRATION_GRPC_CERT_FILE: /tls/runner/grpc-client.crt
      SANDBOX_RUNNER_REGISTRATION_GRPC_KEY_FILE: /tls/runner/grpc-client.key
      SANDBOX_RUNNER_REGISTRATION_GRPC_SERVER_NAME: sandbox-api
      SANDBOX_RUNNER_CONTROL_GRPC_TLS_CERT_FILE: /tls/runner/control-grpc-server.crt
      SANDBOX_RUNNER_CONTROL_GRPC_TLS_KEY_FILE: /tls/runner/control-grpc-server.key
      SANDBOX_RUNNER_CONTROL_GRPC_TLS_CLIENT_CA_FILE: /tls/runner/ca.crt
    depends_on:
      sandbox-api:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://localhost:8080/readyz"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    logging:
      driver: {{ logging_driver }}
      options:
        max-size: {{ logging_max_size }}
        max-file: {{ logging_max_file }}

volumes:
  n8n-data:
    name: n8n-data
  n8n-pgdata:
    name: n8n-pgdata
  n8n-sandbox-tls:
    name: n8n-sandbox-tls
  n8n-sandbox-api-data:
    name: n8n-sandbox-api-data
  n8n-sandbox-dind:
    name: n8n-sandbox-dind

networks:
  proxy:
    name: {{ proxy_network }}
    external: true
  backend:
    name: {{ backend_network }}
    external: true
  # Stack-local: keeps the sandbox service names off the shared backend
  # network, where `sandbox-api` would be an easy alias to collide with.
  # Not `internal: true`: the runner's inner dockerd pulls the sandbox image,
  # and a sandbox installs the workflow SDK from npm on first use.
  sandbox:
    name: {{ stack_name }}-sandbox
