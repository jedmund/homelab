# External Services on {{ max_server_ip }} (Max server)
http:
  routers:
    # Minecraft Panel - mc.{{ traefik_domain }}
    minecraft:
      rule: "Host(`mc.{{ traefik_domain }}`)"
      service: minecraft
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
    # llama-swap web UI - models.{{ traefik_domain }}
    # Port 11434 matches llama_swap_port in roles/ai/defaults/main.yml;
    # kept hardcoded here because the ai role's variables are not in scope
    # from the traefik role. TinyAuth gates the browser UI; OpenAI-compatible
    # API clients (opencode etc.) still reach llama-swap directly via the
    # LAN port on max:11434 without going through Traefik.
    llamaswap:
      rule: "Host(`models.{{ traefik_domain }}`)"
      service: llamaswap
      middlewares:
        - tinyauth@file
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt

    # SearXNG web UI - search.{{ traefik_domain }}
    # Port 8889 matches searxng_port in roles/ai/defaults/main.yml; same
    # cross-role hardcoding caveat as llamaswap above. TinyAuth-gated so
    # the instance isn't reachable from the open internet (would otherwise
    # get rate-limited / banned by upstream engines). LAN clients on the
    # same network as max (e.g. OpenClaw on the mac-mini) still hit
    # http://max:8889 directly without Traefik.
    searxng:
      rule: "Host(`search.{{ traefik_domain }}`)"
      service: searxng
      middlewares:
        - tinyauth@file
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
    # Emulator streaming (RomM 5.1+). Selkies needs a secure context for
    # WebRTC, which is the whole reason these are proxied rather than hit
    # directly on the LAN: Traefik supplies the HTTPS the browser demands.
    #
    # TinyAuth-gated, with a caveat. RomM embeds the stream in its player
    # view, and a forward-auth redirect cannot complete inside that frame,
    # so the first visit of a session has to be to the host directly.
    # After that the cookie covers the embed.
    #
    # Only the Selkies UI is routed. The brokers on max:8010 and max:8020
    # are deliberately absent: RomM calls them server-side over the LAN
    # with a shared secret, and giving them a public hostname would put an
    # unauthenticated launch API on the internet.
    #
    # Ports match pcsx2_selkies_http_port and dolphin_selkies_http_port;
    # same cross-role hardcoding caveat as llamaswap above.
    pcsx2:
      rule: "Host(`pcsx2.{{ traefik_domain }}`)"
      service: pcsx2
      middlewares:
        - tinyauth@file
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt

    # Serves both GameCube and Wii; one container, one hostname.
    dolphin:
      rule: "Host(`dolphin.{{ traefik_domain }}`)"
      service: dolphin
      middlewares:
        - tinyauth@file
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
  services:
    minecraft:
      loadBalancer:
        servers:
          - url: "http://{{ max_server_ip }}:8100"
    llamaswap:
      loadBalancer:
        servers:
          - url: "http://{{ max_server_ip }}:11434"
    searxng:
      loadBalancer:
        servers:
          - url: "http://{{ max_server_ip }}:8889"
    pcsx2:
      loadBalancer:
        servers:
          - url: "http://{{ max_server_ip }}:3010"
    dolphin:
      loadBalancer:
        servers:
          - url: "http://{{ max_server_ip }}:3020"
